# Cổng chạy API Gateway Proxy
PORT=8008

# Endpoint Upstream thật của umodelverse
UPSTREAM_BASE_URL=https://api-us-ca.umodelverse.ai/v1

# Master API Key của umodelverse dùng để forward request
UPSTREAM_MASTER_API_KEY=your_upstream_master_api_key_here

# Kết nối cơ sở dữ liệu để kiểm tra tài khoản & số dư
DATABASE_URL=file:../payload-cms-app.db

# Tỷ giá VNĐ / USD áp dụng khi tính toán cước phí
USD_RATE=26000
