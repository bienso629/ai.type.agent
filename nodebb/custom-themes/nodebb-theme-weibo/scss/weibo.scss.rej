-/* =========================================================
-   WEIBO IMAGE GRID SYSTEM
-   Hiển thị ảnh dưới dạng Lưới cực kỳ tối ưu
-   ========================================================= */
-
-#weibo-quick-post-content {
-    min-height: 100px !important;
-    background-color: var(--bs-body-bg) !important;
-    color: var(--bs-body-color) !important;
-}
-
-.weibo-img-grid {
-    display: grid;
-    gap: 16px;
-    margin-top: 10px;
-
-    @media (max-width: 767.98px) {
-        gap: 4px;
-    }
-
-    &.grid-1 {
-        grid-template-columns: 1fr;
-        max-width: 100%;
-    }
-
-    &.grid-2 {
-        grid-template-columns: repeat(2, 1fr);
-        max-width: 80%;
-    }
-
-    &.grid-3 {
-        grid-template-columns: repeat(3, 1fr);
-        max-width: 100%;
-    }
-
-    .grid-img-wrap {
-        position: relative;
-        aspect-ratio: 1/1;
-        overflow: hidden;
-        border-radius: 10px 16px;
-        cursor: pointer;
-    }
-
-    &.grid-1 .grid-img-wrap {
-        aspect-ratio: auto;
-        border: none;
-        max-height: none;
-    }
-
-    &.grid-1 img {
-        width: 100%;
-        height: auto;
-        max-width: 100%;
-        max-height: none;
-        object-fit: contain;
-        border-radius: 6px;
-    }
-
-    &:not(.grid-1) img {
-        width: 100%;
-        height: 100%;
-        object-fit: cover;
-    }
-}
-
-.more-images-overlay {
-    position: absolute;
-    top: 0;
-    left: 0;
-    right: 0;
-    bottom: 0;
-    background: rgba(var(--bs-body-color-rgb), 0.5);
-    color: var(--bs-body-bg);
