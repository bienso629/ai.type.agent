-            padding: 10px;
-        }
-
-        hr {
-            display: none;
-        }
-    }
-}
-
-[component="chat/message/body"] .img-fluid,
-[component="post/content"] .img-fluid {
-    border: 0;
-    box-shadow: none !important;
-    padding: 0;
-}
-
-[component="brand/wrapper"]:hover {
-    background-color: transparent;
-}
-
-/* Xóa khoảng trống margin-top 4 (mt-4) do cấu trúc Container HTML của Widget Bài Viết Liên Quan từ Backend sinh ra */
-[data-widget-area="footer"] .mt-4,
-[data-widget-area="footer"].mt-4 {
-    margin-top: 0 !important;
-}
-
-/* =========================================================
-   DARK THEME FIXES: HR, TEXTAREA, TIMELINE, BADGES & NAVIGATOR
-   ========================================================= */
-
-hr {
-    border-color: rgba(var(--bs-body-color-rgb), 0.1) !important;
-}
-
-textarea {
-    background-color: transparent !important;
-    color: var(--bs-body-color) !important;
-
-    &:not(:focus) {
-        border: 1px solid rgba(var(--bs-body-color-rgb), 0.15) !important;
-    }
-}
-
-.timeline {
-
-    >[component="post"],
-    .timeline-event,
-    >[component="post/placeholder"] {
