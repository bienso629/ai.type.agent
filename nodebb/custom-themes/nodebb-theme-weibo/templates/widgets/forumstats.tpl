<div class="d-flex forum-stats flex-wrap mb-3 gap-2">
	<div class="flex-1">
		<div class="stats-card text-center {statsClass}">
			<h4 class="stats" title="{online}">{online}</h4>
			<span class="text-secondary small">[[global:online]]</span>
		</div>
	</div>
	<div class="flex-1">
		<div class="stats-card text-center {statsClass}">
			<h4 class="stats" title="{topics}">{topics}</h4>
			<span class="text-secondary small">[[global:topics]]</span>
		</div>
	</div>
	<div class="flex-1">
		<div class="stats-card text-center {statsClass}">
			<h4 class="stats" title="{posts}">{posts}</h4>
			<span class="text-secondary small">[[global:posts]]</span>
		</div>
	</div>
</div>
