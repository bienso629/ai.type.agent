# ==========================================
# Chatbot & Website RAG Environment Config
# ==========================================

# Google Gemini API Key
GEMINI_API_KEY=

# Thư mục lưu trữ PDF và FAISS Index
PDF_DIR=pdfs
INDEX_DIR=faiss_pdf_index

# Model Embedding Tiếng Việt
EMBED_MODEL=AITeamVN/Vietnamese_Embedding
CHUNK_SIZE=3000
CHUNK_OVERLAP=300

# OCR Settings
ENABLE_OCR=false
OCR_DPI=200

# JWT Authentication
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_MIN=10080

# Google OAuth (Tuỳ chọn)
GOOGLE_CLIENT_ID=

# Website Service URL
WEBSITE_API_URL=http://127.0.0.1:8003
MAX_DOMAINS_IN_RAM=5
